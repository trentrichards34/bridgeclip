{
  "name": "gauge-dial",
  "title": "Gauge",
  "source": "CreatorClips' own unit in the style of HyperFrames registry/components/conic-progress-ring (Apache-2.0)",
  "variables": [
    {
      "id": "value",
      "type": "string",
      "label": "The number as said",
      "default": ""
    },
    {
      "id": "max",
      "type": "string",
      "label": "Top of the scale (100 for a percent)",
      "default": "100"
    },
    {
      "id": "unit",
      "type": "string",
      "label": "After the number (% or /10)",
      "default": "%"
    },
    {
      "id": "label",
      "type": "string",
      "label": "Words under it",
      "default": ""
    }
  ]
}
